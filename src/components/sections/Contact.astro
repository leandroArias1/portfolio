
<section id="contact" class="py-32 reveal">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

      <!-- Columna izquierda: texto -->
      <div class="flex flex-col gap-6 reveal reveal-delay-1">
        <h2 class="text-5xl md:text-6xl font-heading tracking-tight text-text leading-[1.05]">
          Contacto
        </h2>

        <p class="text-muted max-w-md leading-relaxed text-lg">
          ¿Tenés un proyecto, una propuesta o simplemente querés hablar?
          Completá el formulario y te respondo lo antes posible.
        </p>

        <div class="space-y-5 pt-4">
          <div class="flex items-center gap-4">
            <span class="h-11 w-11 rounded-xl bg-bgSecondary border border-black/10 dark:border-white/10 inline-flex items-center justify-center text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4 4 16 0 0 16-16 0zM22 6l-10 7L2 6"/>
              </svg>
            </span>
            <div>
              <p class="text-[10px] uppercase tracking-[0.25em] text-muted font-bold">Email</p>
              <p class="text-text font-medium">leanahuelarias@gmail.com</p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <span class="h-11 w-11 rounded-xl bg-bgSecondary border border-black/10 dark:border-white/10 inline-flex items-center justify-center text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-4.5 7-10a7 7 0 1 0-14 0c0 5.5 7 10 7 10Z"/>
                <circle cx="12" cy="11" r="2.5"/>
              </svg>
            </span>
            <div>
              <p class="text-[10px] uppercase tracking-[0.25em] text-muted font-bold">Base</p>
              <p class="text-text font-medium">Argentina / Remoto</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna derecha: formulario -->
      <form
        id="contact-form"
        class="bg-bgSecondary border border-black/5 dark:border-white/5 rounded-[2rem] p-8 md:p-10 grid grid-cols-1 gap-7 reveal reveal-delay-2 shadow-2xl shadow-black/5 dark:shadow-accent/10"
      >
        <div class="space-y-2">
          <label for="name" class="text-[10px] uppercase tracking-[0.2em] text-muted font-bold">Nombre</label>
          <input
            id="name"
            type="text"
            name="name"
            placeholder="Tu nombre"
            required
            class="w-full bg-transparent border-b-2 border-black/10 dark:border-white/10 px-0 py-3 text-sm text-text placeholder:text-muted focus:outline-none focus:border-accent"
          />
        </div>

        <div class="space-y-2">
          <label for="email" class="text-[10px] uppercase tracking-[0.2em] text-muted font-bold">Email</label>
          <input
            id="email"
            type="email"
            name="email"
            placeholder="Tu email"
            required
            class="w-full bg-transparent border-b-2 border-black/10 dark:border-white/10 px-0 py-3 text-sm text-text placeholder:text-muted focus:outline-none focus:border-accent"
          />
        </div>

        <div class="space-y-2">
          <label for="message" class="text-[10px] uppercase tracking-[0.2em] text-muted font-bold">Mensaje</label>
          <textarea
            id="message"
            name="message"
            rows="3"
            placeholder="Contame brevemente tu idea o propuesta"
            required
            class="w-full resize-none bg-transparent border-b-2 border-black/10 dark:border-white/10 px-0 py-3 text-sm text-text placeholder:text-muted focus:outline-none focus:border-accent"
          ></textarea>
        </div>

        <!-- Botón -->
        <div class="flex justify-start pt-3">
          <button
            id="submit-btn"
            type="submit"
            class="send-btn font-heading tracking-[0.18em] uppercase rounded-full bg-accent px-8 py-3 text-xs font-semibold text-white hover:opacity-90 transition shadow-lg shadow-accent/30 inline-flex items-center gap-2"
          >
            <span id="submit-text">Enviar mensaje</span>
            <svg id="submit-plane" xmlns="http://www.w3.org/2000/svg" class="send-plane h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M22 2 11 13"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="m22 2-7 20-4-9-9-4 20-7Z"></path>
            </svg>
          </button>
        </div>

        <!-- Estado del formulario -->
        <p
          id="form-status"
          class="hidden text-sm text-accent pt-2"
        >
          Mensaje enviado correctamente. Te voy a responder pronto 🙂
        </p>
      </form>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");
  const submitBtn = document.getElementById("submit-btn");
  const submitText = document.getElementById("submit-text");

  if (form instanceof HTMLFormElement && status instanceof HTMLElement) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
        submitBtn.classList.add("is-sending");
      }
      if (submitText instanceof HTMLElement) submitText.textContent = "Mandando...";

      const formData = new FormData(form);

      try {
        const response = await fetch("https://formspree.io/f/xwvvoppq", {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json",
          },
        });

        status.classList.remove("hidden");

        if (response.ok) {
          form.reset();
          status.textContent =
            "Mensaje enviado correctamente. Te voy a responder pronto 🙂";
        } else {
          status.textContent =
            "Hubo un error al enviar el mensaje. Probá de nuevo.";
        }
      } finally {
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          submitBtn.classList.remove("is-sending");
        }
        if (submitText instanceof HTMLElement) submitText.textContent = "Enviar mensaje";
      }
    });
  }
</script>
