---
---

<section
  id="home"
  class="min-h-screen flex items-center hero-spotlight overflow-hidden"
>
  <div class="absolute inset-0 hero-grid pointer-events-none"></div>
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

    <!-- Texto -->
    <div>
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-bgSecondary text-muted text-[10px] font-bold tracking-[0.2em] mb-8 reveal reveal-delay-1 border border-black/5 dark:border-white/10">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        FULL STACK ENGINEER
      </div>

      <h1 class="text-5xl md:text-6xl lg:text-7xl font-heading tracking-tight leading-[1] reveal reveal-delay-2 max-w-[16ch]">
        <span class="type-segment segment-1 block">Desarrollador</span>
        <span class="type-segment segment-2 block text-accent">Web</span>
        <span class="type-segment segment-4 block">Full Stack</span>
      </h1>

      <p class="mt-6 text-lg text-muted max-w-xl reveal reveal-delay-3">
        Enfocado en productos web rápidos, escalables y bien diseñados.
      </p>

      <div class="mt-8 flex gap-4 reveal reveal-delay-3">
        <a
          href="#projects"
          class="btn-glow font-heading tracking-wide inline-flex items-center justify-center rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white hover:-translate-y-0.5 hover:opacity-90 active:translate-y-0"
        >
          Ver proyectos
        </a>

        <a
          href="#contact"
          class="font-heading tracking-wide inline-flex items-center justify-center rounded-lg border border-black/10 bg-bgSecondary px-6 py-3 text-sm font-semibold text-text hover:-translate-y-0.5 hover:opacity-90 active:translate-y-0 dark:border-white/10"
        >
          Contactar
        </a>
      </div>
    </div>

    <!-- Visual -->
    <div class="hidden md:flex justify-center reveal reveal-delay-2">
      <div class="relative">
        <div class="absolute -inset-10 bg-accent/10 blur-3xl rounded-full opacity-60"></div>
        <div class="relative h-80 w-72 rounded-3xl overflow-hidden image-glow-container">
          <img src="/projects/foto-perfil.png" alt="Foto de perfil de Leandro Arias" class="h-full w-full object-cover hover:scale-105 transition-all duration-1000" />
        </div>
        <div class="absolute -bottom-6 -left-8 bg-bgSecondary/85 backdrop-blur rounded-2xl border border-black/10 dark:border-white/10 px-5 py-4 float-soft">
          <p class="text-2xl font-bold font-heading text-accent">1+</p>
          <p class="text-[10px] tracking-widest uppercase text-muted">Año creando<br />productos web</p>
        </div>
      </div>
    </div>

  </div>
</section>
