---
import { skills } from "../../data/skills";

// Iconos
import Html5 from "../icons/Html.astro";
import Css3 from "../icons/Css.astro";
import Js from "../icons/Js.astro";
import Ts from "../icons/Ts.astro";
import ReactIcon from "../icons/React.astro";
import Postman from "../icons/Postman.astro";
import PostgreSQL from "../icons/PostgreSQL.astro";
import Express from "../icons/Express.astro";
import AstroIcon from "../icons/Astro.astro";
import MongoDB from "../icons/MongoDB.astro";
import Tailwind from "../icons/Tailwind.astro";
import Node from "../icons/Node.astro";
import Git from "../icons/Git.astro";
import Github from "../icons/Github.astro";

const ICONS = {
  html: Html5,
  css: Css3,
  javascript: Js,
  typescript: Ts,
  react: ReactIcon,
  express: Express,
  postman: Postman,
  postgresql: PostgreSQL,
  astro: AstroIcon,
  mongodb: MongoDB,
  tailwindcss: Tailwind,
  nodejs: Node,
  git: Git,
  github: Github,
};

const coreSkills = [
  "react",
  "nodejs",
  "postgresql",
  "mongodb",
  "astro",
  "tailwindcss",
] as const;

const flatSkills = skills.flatMap((group) => group.skills);
const visibleSkills = coreSkills
  .map((iconName) => flatSkills.find((skill) => skill.icon === iconName))
  .filter(Boolean);
---

<section id="skills" class="py-24 reveal">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-14 text-center reveal reveal-delay-1">
      <p class="text-[10px] uppercase tracking-[0.35em] text-accent font-bold">Stack profesional</p>
      <h2 class="mt-4 text-4xl md:text-5xl font-heading tracking-tight text-text">Skills</h2>
    </div>

    <div class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {
        visibleSkills.map((skill, index) => {
          const Icon = skill ? ICONS[skill.icon] : null;
          return (
          <div class={`skill-card rounded-2xl bg-bgSecondary border border-black/5 dark:border-white/10 p-6 reveal ${index % 3 === 0 ? "reveal-delay-1" : index % 3 === 1 ? "reveal-delay-2" : "reveal-delay-3"}`}>
            <div class="flex flex-col items-center justify-center gap-4">
              <div class="text-accent">{Icon && <Icon />}</div>
              <p class="text-[10px] tracking-[0.2em] font-bold text-muted uppercase text-center">{skill?.name}</p>
            </div>
          </div>
        )})
      }
    </div>
  </div>
</section>
