---
import BaseLayout from "../layouts/BaseLayout.astro";
import { extraProjects } from "../data/projects";
import ProjectCard from "../components/ui/ProjectCard.astro";
---

<BaseLayout>
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6">

      <header class="mb-12">
        <h1 class="text-5xl font-heading tracking-tight text-text">
          Más proyectos
        </h1>
        <p class="mt-4 text-muted max-w-xl">
          Otros proyectos y landings desarrollados.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {extraProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>

      <!-- Volver -->
      <div class="mt-20">
        <a
          href="/#projects"
          class="text-sm text-muted hover:text-text transition"
        >
          ← Volver a proyectos
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
